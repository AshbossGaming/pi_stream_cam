[Unit]
Description=Pi Stream Cam - PTZ Camera Surveillance System
Documentation=https://github.com/AshbossGaming/pi_stream_cam
After=network.target mediamtx.service
Wants=network-online.target mediamtx.service

[Service]
Type=simple
DynamicUser=yes
SupplementaryGroups=video i2c gpio
WorkingDirectory=/opt/pi-stream-cam/current
ExecStart=/opt/pi-stream-cam/current/pi-stream-cam
ExecStartPre=/bin/sh -c 'test -e /dev/i2c-1 || echo "[WARN] No I2C device — servos will be simulated"'
Restart=always
RestartSec=10
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
CPUWeight=20
AllowedCPUs=1-2
MemoryMax=384M
MemoryHigh=256M
StateDirectory=pi-stream-cam
StateDirectoryMode=0755
LogsDirectory=pi-stream-cam
LogsDirectoryMode=0755
StandardOutput=journal
StandardError=journal
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
Environment=PORT=5000

[Install]
WantedBy=multi-user.target
