[Unit]
Description=Pi Stream Cam Service
After=network.target

[Service]
Type=simple
User=picam
WorkingDirectory=/opt/pi-stream-cam/current
ExecStart=/opt/pi-stream-cam/current/pi-stream-cam
Restart=always
RestartSec=10
StandardOutput=append:/var/log/pi-stream-cam/output.log
StandardError=append:/var/log/pi-stream-cam/error.log
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
Environment=CONTROL_PORT=5000
Environment=STREAM_PORT=5001
Environment=GST_DEBUG=0

[Install]
WantedBy=multi-user.target
